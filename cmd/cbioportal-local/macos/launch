#!/bin/bash
# Opens cbioportal-local in a Terminal window, so its log shows and closing
# the window (or Ctrl+C) stops the portal. Without a folder it asks for one.
here="$(cd "$(dirname "$0")" && pwd)"
exec osascript \
  -e 'tell application "Terminal"' \
  -e 'activate' \
  -e "do script quoted form of \"$here/cbioportal-local\"" \
  -e 'end tell'
